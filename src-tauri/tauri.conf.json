{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "XiaoxinStickyNote",
  "version": "1.0.0",
  "identifier": "com.xiaoxin.xiaoxinstickynote",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "便签",
        "url": "index.html?noteId=main",
        "width": 420,
        "height": 440,
        "minWidth": 220,
        "minHeight": 150,
        "x": 400,
        "y": 300,
        "center": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "particles",
        "title": "粒子层",
        "url": "index.html",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "focusable": false,
        "resizable": false,
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "center": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

